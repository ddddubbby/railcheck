# Network: EthereumSepolia (default) or Ethereum (mainnet trial only)
RAILGUN_NETWORK=EthereumSepolia

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional amount overrides
# SHIELD_ETH=0.01
# UNSHIELD_ETH=0.005

# Filled by `npm run create-wallet`. Do not commit.
MNEMONIC=
ENCRYPTION_KEY=
RAILGUN_WALLET_ID=
PUBLIC_ADDRESS=
RAILGUN_ADDRESS=
