{
  "name": "railcheck",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "railcheck",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "lib",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "lib": {
      "name": "@railcheck/core",
      "version": "0.1.0-preview.0",
      "license": "MIT",
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@railcheck/builder": {
      "resolved": "packages/builder",
      "link": true
    },
    "node_modules/@railcheck/core": {
      "resolved": "lib",
