    },
    "node_modules/@railcheck/kohaku": {
      "resolved": "packages/kohaku",
      "link": true
    },
    "packages/builder": {
      "name": "@railcheck/builder",
      "version": "0.1.0-preview.0",
      "license": "MIT",
      "dependencies": {
        "@railcheck/core": "0.1.0-preview.0"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/kohaku": {
      "name": "@railcheck/kohaku",
      "version": "0.1.0-preview.0",
      "license": "MIT",
      "dependencies": {
        "@railcheck/core": "0.1.0-preview.0"
      },
      "engines": {
        "node": ">=22"
      }
    }
  }
}
