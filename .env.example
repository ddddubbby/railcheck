# Build-only settings. These are never loaded by the browser.
# Set SITE_URL to your real HTTPS origin, without a path.
SITE_URL=
# Optional: your repository URL for the Source code link.
SOURCE_URL=
# Optional: Ethereum mainnet RPC. Public fallbacks work without this.
RPC_URL=
# Used only by the optional GitHub Actions deploy-hook step.
VERCEL_DEPLOY_HOOK=
