# Build-only settings. These are never loaded by the browser.
# Set SITE_URL to your real HTTPS origin, without a path.
SITE_URL=
# Optional: your repository URL for the Source code link.
SOURCE_URL=
# Optional: Ethereum mainnet RPC with historical logs. When set, it is the only
# primary endpoint. The updater does not fall back to a public endpoint.
RPC_URL=
# Optional: second Ethereum mainnet RPC on a different host. It must return the
# same logs before a snapshot is published. When unset, a public endpoint is used.
RPC_WITNESS_URL=
# Used only by the optional GitHub Actions deploy-hook step.
VERCEL_DEPLOY_HOOK=
